#!/bin/sh
# license-ctl —— license-server 运维 CLI 包装脚本
#
# 为什么需要它（踩过的坑，勿删）：
#   `license-server` 的 --db 默认值是 `./license.db`（cwd 相对路径），
#   而 systemd 服务用的是 /opt/license-server/data/license.db。
#   裸跑 `sudo /opt/license-server/license-server list` 会在 cwd 下新建一个空库，
#   表现为"共 0 条记录"；此时 issue 发出来的码写进空库，用户拿码激活必报 1001。
#   另外 sudo 会清掉环境变量，所以光配 LICENSE_DB 也不够，必须显式加载 env 文件。
#
# 安装：
#   sudo install -m 0755 license-ctl /usr/local/bin/license-ctl
#   sudo cp license-server.env /etc/license-server.env && sudo chmod 600 /etc/license-server.env
#
# 用法：
#   sudo license-ctl list
#   sudo license-ctl issue --type month        # month | permanent
#   sudo license-ctl revoke <CODE>
#   sudo license-ctl rebind <CODE>
set -a
. /etc/license-server.env
set +a
exec /opt/license-server/license-server "$@"
