<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.carlos">
    <!--外部存储的写权限-->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!--外部存储的读权限-->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- SandHook -->
    <uses-sdk tools:overrideLibrary="com.swift.sandhook.lib, com.swift.sandhook.xposedcompat"/>

    <uses-permission android:name="${PACKAGE_NAME_32BIT}.permission.SAFE_ACCESS" />
    <!-- 通话记录 -->
    <uses-permission android:name="android.permission.PROCESS_OUTGOING_CALLS" />
    <!-- call phone -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <!-- sms-->
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.WRITE_SMS" />
    <!-- google app start -->
    <uses-permission android:name="com.google.android.googleapps.permission.GOOGLE_AUTH" />
    <uses-permission android:name="com.google.android.googleapps.permission.GOOGLE_AUTH.OTHER_SERVICES" />
    <uses-permission android:name="com.google.android.googleapps.permission.GOOGLE_AUTH.YouTubeUser" />
    <!-- google app end -->

    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+ 前台服务通知需要运行时授权；不声明该权限时
         AccountVaultActivity.requestNotifPermission 的请求不会弹窗，保活/调度通知在 13+ 不可见 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 24h 常驻在线：引导用户把号库加入电池优化白名单（否则 Doze 会掐心跳连接） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 容器微信(Android14+)注册截屏检测回调需要，以宿主身份申请 -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />

    <application
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:requestLegacyExternalStorage="true"
        android:networkSecurityConfig="@xml/network_security"
        android:resizeableActivity="true"
        android:name="com.carlos.common.App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@style/AppTheme"
        tools:ignore="GoogleAppIndexingWarning,HardcodedDebugMode">
        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="77f19c1a1debd7687c396a196a88195b" />
        <meta-data
            android:name="ScorpionSDK"
            android:value="zxc77848" />

        <activity
            android:name="com.carlos.vault.HomeActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.carlos.splash.splashActivity"
            android:exported="true"
            android:theme="@style/AppTheme">
        </activity>
        <activity
            android:name="com.carlos.vault.AccountVaultActivity"
            android:exported="true"
            android:theme="@style/AppTheme">
            
        </activity>
        <!-- 批次7（task-25）：新用户初始化引导页（①兑换码 ②克隆/初始化 ③添加分身账户 ④打开游戏分身
             ⑤打开自动化（T2+））。仅 App 内部跳转（首启/☰ 功能菜单），不导出。 -->
        <activity
            android:name="com.carlos.vault.OnboardingActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <service
            android:name="com.carlos.vault.daily.DailySchedulerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <receiver
            android:name="com.carlos.vault.daily.DailyBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- 游戏原生通知监听（反应式开盾 WAR/RECON、部队返回补采集、治疗完成续批、建造完成刷状态）。
             NotificationListenerService 必须由系统绑定：需要该权限声明 + intent-filter，
             用户在「通知使用权」里授权后才生效（GameNotifyListenerService.enabled() 检测并引导）。 -->
        <service
            android:name="com.carlos.vault.daily.GameNotifyListenerService"
            android:label="号库游戏通知监听"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <activity
            android:name="com.carlos.vault.daily.FunctionActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <!-- 真机监控（2026-10-25）：服务端任务级协议监控实时页；工具箱「真机监控」进入 -->
        <activity
            android:name="com.carlos.vault.daily.MonitorActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <!-- 采集设置页（批次12）：6 队列采集配置，从功能详情页「采集参数」卡片进入 -->
        <activity
            android:name="com.carlos.vault.daily.GatherConfigActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <!-- 编队管理页（1:1 网页版「编队管理」弹窗，2026-10-25）：
             自动编队/游戏编队/我的编队 3 tab + 编队板 + 编辑器；从功能页编队卡进入。 -->
        <activity
            android:name="com.carlos.vault.daily.FormationManagerActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <!-- 资产中心（W9）：核心资产库 9 大域只读展示，从今日页「资产」快捷入口进入 -->
        <activity
            android:name="com.carlos.vault.AssetCenterActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.carlos.vault.ToolBoxActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.carlos.vault.EntryDetailActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <!-- 微信扫码登录（2026-10-27 新增）：二维码 → 微信确认 → fpid+token 直接入号库 -->
        <activity
            android:name="com.carlos.vault.wechat.WechatQrLoginActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <!-- 战争通知设置：监视名单/企微机器人/短信/最近事件（2026-10-22） -->
        <activity
            android:name="com.carlos.vault.NotifySettingsActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <!-- 游戏保活前台服务。目的：切到微信等后台时，游戏进程不被系统 LMK 回收。
             必须留在宿主主进程，不能指定 android:process=":p0"。
             早先绑定在 VA 的游戏 stub 进程 :p0 上，而 :p0 与游戏同进程：
             829M Unity 首启会把该进程主线程打满，startForegroundService() 之后
             onStartCommand 排不上队，Android 8+ 的 5 秒死限被击穿，抛
             ForegroundServiceDidNotStartInTimeException，反而把游戏进程杀掉。
             放宿主主进程后，宿主主线程此时是空闲的（用户正看着宿主界面），能按时
             startForeground()；而前台服务提升的是同 UID 的进程优先级，
             com.gof.china 与宿主同为 u0_a373，游戏进程同样受保护，保活目的仍达成。 -->
        <!-- foregroundServiceType=dataSync：targetSdk 26 暂不强制，先为后续升级到
             34/35 铺路；注意 Android 15 对 dataSync 有 6h/24h 限制，长期保活
             应优先走 vault-server 服务器模式（见 design/targetSdk-兼容评估-20261018.md）。 -->
        <service
            android:name="com.carlos.vault.GameKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />


        <activity
            android:name="com.carlos.home.HomeActivity"
            android:theme="@style/UITheme" />

        <activity
            android:name="com.carlos.home.ListAppActivity"
            android:theme="@style/UITheme" />


        <activity
            android:name="com.carlos.home.PermissionRequestActivity"
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name="com.carlos.home.AppSettingActivity"
            android:theme="@style/UITheme.HasActionBar" />

        <activity android:name="com.carlos.home.XposedManager.XposedManagerActivity"
            android:label="Xposed Manager"
            android:theme="@style/UITheme" />
        <!-- va的x进程处理 -->
        <receiver
            android:name="com.carlos.PackageReceiver"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />

                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>



        <!--<provider
            android:name=".sandxposed.SandHookConfigProvider"
            android:authorities="io.virtualapp.sandvxposed:x"
            android:exported="false"
            android:process=":x" />-->
        <receiver
            android:name="com.carlos.vault.daily.HotConfigReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.carlos.multiapp.HOT_REFRESH" />
            </intent-filter>
        </receiver>

    </application>


</manifest>
