# /etc/vault-server.env — vault-server 运行配置（systemd EnvironmentFile）
# VAULT_SECRET 必须与 App 端 VaultSync 内置密钥一致（base64+XOR 混淆前的明文）
VAULT_SECRET=vaultsrv-2026-hmac-key
VAULT_LISTEN=127.0.0.1:8790
VAULT_DATA_DIR=/opt/vault-server/data

# 静态住宅出口（可选；买了代理后取消注释填入 host:port）
# VAULT_SOCKS=127.0.0.1:1080

# 首启默认顶号策略：human_first / grab_back / yield_only
VAULT_TAKEOVER_POLICY=human_first
