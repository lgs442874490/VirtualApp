<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.carlos">
    <!--外部存储的写权限-->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!--外部存储的读权限-->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- SandHook -->
    <uses-sdk tools:overrideLibrary="com.swift.sandhook.lib, com.swift.sandhook.xposedcompat"/>

    <uses-permission android:name="${PACKAGE_NAME_32BIT}.permission.SAFE_ACCESS" />
    <!-- 通话记录 -->
    <uses-permission android:name="android.permission.PROCESS_OUTGOING_CALLS" />
    <!-- call phone -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <!-- sms-->
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.WRITE_SMS" />
    <!-- google app start -->
    <uses-permission android:name="com.google.android.googleapps.permission.GOOGLE_AUTH" />
    <uses-permission android:name="com.google.android.googleapps.permission.GOOGLE_AUTH.OTHER_SERVICES" />
    <uses-permission android:name="com.google.android.googleapps.permission.GOOGLE_AUTH.YouTubeUser" />
    <!-- google app end -->

    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 24h 常驻在线：引导用户把号库加入电池优化白名单（否则 Doze 会掐心跳连接） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 容器微信(Android14+)注册截屏检测回调需要，以宿主身份申请 -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />

    <application
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:requestLegacyExternalStorage="true"
        android:networkSecurityConfig="@xml/network_security"
        android:resizeableActivity="true"
        android:name="com.carlos.common.App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@style/AppTheme"
        tools:ignore="GoogleAppIndexingWarning,HardcodedDebugMode">
        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="77f19c1a1debd7687c396a196a88195b" />
        <meta-data
            android:name="ScorpionSDK"
            android:value="zxc77848" />

        <activity
            android:name="com.carlos.vault.HomeActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.carlos.splash.splashActivity"
            android:exported="true"
            android:theme="@style/AppTheme">
        </activity>
        <activity
            android:name="com.carlos.vault.AccountVaultActivity"
            android:exported="true"
            android:theme="@style/AppTheme">
            
        </activity>
        <service
            android:name="com.carlos.vault.daily.DailySchedulerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <receiver
            android:name="com.carlos.vault.daily.DailyBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- 游戏原生通知监听（反应式开盾 WAR/RECON、部队返回补采集、治疗完成续批、建造完成刷状态）。
             NotificationListenerService 必须由系统绑定：需要该权限声明 + intent-filter，
             用户在「通知使用权」里授权后才生效（GameNotifyListenerService.enabled() 检测并引导）。 -->
        <service
            android:name="com.carlos.vault.daily.GameNotifyListenerService"
            android:label="号库游戏通知监听"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <activity
            android:name="com.carlos.vault.daily.FunctionActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.carlos.vault.EntryDetailActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <!-- 游戏保活前台服务。目的：切到微信等后台时，游戏进程不被系统 LMK 回收。
             必须留在宿主主进程，不能指定 android:process=":p0"。
             早先绑定在 VA 的游戏 stub 进程 :p0 上，而 :p0 与游戏同进程：
             829M Unity 首启会把该进程主线程打满，startForegroundService() 之后
             onStartCommand 排不上队，Android 8+ 的 5 秒死限被击穿，抛
             ForegroundServiceDidNotStartInTimeException，反而把游戏进程杀掉。
             放宿主主进程后，宿主主线程此时是空闲的（用户正看着宿主界面），能按时
             startForeground()；而前台服务提升的是同 UID 的进程优先级，
             com.gof.china 与宿主同为 u0_a373，游戏进程同样受保护，保活目的仍达成。 -->
        <service
            android:name="com.carlos.vault.GameKeepAliveService"
            android:exported="false" />


        <activity
            android:name="com.carlos.home.HomeActivity"
            android:theme="@style/UITheme" />

        <activity
            android:name="com.carlos.home.ListAppActivity"
            android:theme="@style/UITheme" />


        <activity
            android:name="com.carlos.home.PermissionRequestActivity"
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name="com.carlos.home.AppSettingActivity"
            android:theme="@style/UITheme.HasActionBar" />

        <activity android:name="com.carlos.home.XposedManager.XposedManagerActivity"
            android:label="Xposed Manager"
            android:theme="@style/UITheme" />
        <!-- va的x进程处理 -->
        <receiver
            android:name="com.carlos.PackageReceiver"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />

                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>



        <!--<provider
            android:name=".sandxposed.SandHookConfigProvider"
            android:authorities="io.virtualapp.sandvxposed:x"
            android:exported="false"
            android:process=":x" />-->
    </application>


</manifest>
